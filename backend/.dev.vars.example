# Copy to `.dev.vars` for local `wrangler dev`. NEVER commit real secrets.
# Preferred: Worker fetches xAI from Doppler at runtime (no key in Flutter).
DOPPLER_SERVICE_TOKEN=
DOPPLER_PROJECT=twiffel
DOPPLER_CONFIG=prd
# Optional local override only (skip Doppler API).
# Canonical Doppler name: TWIFFEL_XAI_API_KEY (legacy alias XAI still accepted).
# TWIFFEL_XAI_API_KEY=
# TWIFFEL_XAI_MODEL=grok-3-mini
