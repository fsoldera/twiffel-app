# Copy to `.dev.vars` for local `wrangler dev`. NEVER commit real secrets.
# Preferred: Worker fetches xAI from Doppler at runtime (no key in Flutter).
DOPPLER_SERVICE_TOKEN=
DOPPLER_PROJECT=twiffel
DOPPLER_CONFIG=prd
